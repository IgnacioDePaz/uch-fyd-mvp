# Local development only. Replace these values before using a shared or public environment.
MONGO_ROOT_USER=uch_dev
MONGO_ROOT_PASSWORD=local-mongo-password-change-me
MONGO_DATABASE=uch_fyd_auth

POSTGRES_DB=uch_fyd
POSTGRES_USER=uch_dev
POSTGRES_PASSWORD=local-postgres-password-change-me

# These values must match between auth-service and core-service.
JWT_SECRET=local-jwt-secret-change-me-at-least-32-characters
ADMIN_API_KEY=local-admin-key-change-me-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-private-password-of-12-chars-minimum

AUTH_PORT=3000
CORE_PORT=3001
